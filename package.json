{
  "name": "atlas",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build_viewer.ts",
    "build:check": "bun scripts/build_viewer.ts --check",
    "build:native": "bun scripts/build_native.ts",
    "typecheck": "bunx --bun tsc --noEmit && bunx --bun tsc --noEmit -p tsconfig.scripts.json",
    "test": "bun test scripts/src",
    "test:viewer": "bun test --timeout 60000 scripts/viewer-acceptance",
    "differential": "bun scripts/differential/run.ts",
    "verify": "bun run build:native && bun run typecheck && bun run build:check && bun run test && bun run differential"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "playwright": "1.54.0",
    "typescript": "6.0.3"
  }
}
